<Window x:Class="JarvisProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis" Height="550" Width="700">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="ChatLog"
                 Grid.Row="0"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontSize="15"
                 Padding="12" />

        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <Button x:Name="SendButton"
                    DockPanel.Dock="Right"
                    Content="Enviar"
                    Width="100"
                    Margin="10,0,0,0"
                    Click="SendButton_Click" />

            <TextBox x:Name="PromptBox"
                     MinHeight="40"
                     VerticalContentAlignment="Center"
                     KeyDown="PromptBox_KeyDown" />
        </DockPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,12,0,0">
            <CheckBox x:Name="VoiceEnabledCheckBox"
                      Content="Activar voz"
                      IsChecked="True"
                      VerticalAlignment="Center" />

            <Button Content="Detener voz"
                    Margin="20,0,0,0"
                    Padding="12,5"
                    Click="StopVoiceButton_Click" />

            <Button x:Name="MicButton"
                    Content="🎤 Hablar"
                    Margin="20,0,0,0"
                    Padding="12,5"
                    Click="MicButton_Click" />

            <CheckBox x:Name="WakeEnabledCheckBox"
                      Content="Activación por voz"
                      IsChecked="True"
                      Margin="20,0,0,0"
                      VerticalAlignment="Center"
                      Checked="WakeEnabledChanged"
                      Unchecked="WakeEnabledChanged" />
        </StackPanel>
    </Grid>
</Window>
